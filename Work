import com.google.cloud.spanner.DatabaseAdminClient;
import com.google.cloud.spanner.DatabaseAdminSettings;

import java.util.List;

public class SpannerDDLExtractor {

    public static void main(String[] args) throws Exception {

        String projectId = "your-project-id";
        String instanceId = "your-instance-id";
        String databaseId = "your-database-id";
        String tableName = "YOUR_TABLE_NAME";

        DatabaseAdminSettings settings = DatabaseAdminSettings.newBuilder().build();

        try (DatabaseAdminClient adminClient =
                     DatabaseAdminClient.create(settings)) {

            List<String> ddlStatements =
                    adminClient.getDatabaseDdl(projectId, instanceId, databaseId);

            System.out.println("DDL for table: " + tableName);
            System.out.println("--------------------------------");

            boolean print = false;

            for (String ddl : ddlStatements) {

                if (ddl.startsWith("CREATE TABLE " + tableName + " ")) {
                    print = true;
                }

                if (print) {
                    System.out.println(ddl);
                }

                // Stop when next CREATE TABLE starts
                if (print
                        && ddl.startsWith("CREATE TABLE ")
                        && !ddl.startsWith("CREATE TABLE " + tableName + " ")) {
                    break;
                }
            }
        }
    }
}