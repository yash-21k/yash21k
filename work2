CREATE TEMP FUNCTION XML_FLATTEN(xml STRING)
RETURNS ARRAY<STRUCT<xpath STRING, value STRING>>
LANGUAGE js AS r"""
  const result = [];
  const stack = [];

  // Remove XML declaration, comments and CDATA handling separately
  xml = xml.replace(/<\?xml[\s\S]*?\?>/g, '');
  xml = xml.replace(/<!--[\s\S]*?-->/g, '');

  // Split XML into tags and text
  const tokens = xml.match(/<[^>]+>|[^<]+/g) || [];

  for (const token of tokens) {

    // Closing tag
    if (/^<\//.test(token)) {
      stack.pop();
      continue;
    }

    // Opening tag
    if (/^</.test(token)) {

      // Ignore declarations / processing instructions
      if (/^<\?/.test(token) || /^<!/.test(token)) {
        continue;
      }

      const selfClosing = /\/>$/.test(token);

      // Extract tag name
      const match = token.match(/^<\s*([^\s/>]+)/);

      if (!match) {
        continue;
      }

      const tagName = match[1];

      stack.push(tagName);

      if (selfClosing) {
        stack.pop();
      }

      continue;
    }

    // Text value
    const value = token.trim();

    if (value && stack.length > 0) {
      result.push({
        xpath: '/' + stack.join('/'),
        value: value
      });
    }
  }

  return result;
""";

SELECT
  x.xpath,
  x.value
FROM `hsbc-8578861-pd1.pdp_global_eu_globalwallet_raw_tab_sit_dev0000.message_rt` t,
UNNEST(XML_FLATTEN(t.body)) x;