package com.example.spannersync;

import com.google.cloud.spanner.DatabaseClient;
import com.google.cloud.spanner.DatabaseId;
import com.google.cloud.spanner.ResultSet;
import com.google.cloud.spanner.Spanner;
import com.google.cloud.spanner.SpannerOptions;
import com.google.cloud.spanner.Statement;
import com.google.cloud.spanner.admin.database.v1.DatabaseAdminClient;
import com.google.spanner.admin.database.v1.DatabaseName;
import com.google.gson.Gson;
import com.google.gson.annotations.SerializedName;

import java.io.FileReader;
import java.io.Reader;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.LinkedHashSet;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.Set;

/**
 * A tiny "terraform for Spanner schema" tool.
 *
 * You describe your desired tables/columns in a JSON file. This tool:
 *   1. Reads the live schema from INFORMATION_SCHEMA.COLUMNS
 *   2. Diffs it against the JSON, classifying every difference as
 *      ADD / MODIFY (size change) / DELETE
 *   3. Prints a clear, categorized report of exactly what it found
 *   4. Optionally applies the DDL needed to reconcile
 *
 * Deletions are destructive, so they are always reported but are only ever
 * executed if you explicitly pass --allow-delete. Without that flag,
 * columns that exist in Spanner but were removed from schema.json are
 * called out as warnings and left untouched.
 *
 * Usage:
 *   java -jar spanner-schema-sync.jar <projectId> <instanceId> <databaseId> <schema.json> [--apply] [--allow-delete]
 *
 * Without --apply it just prints the plan (dry run).
 * With --apply it executes ADD/MODIFY (and DELETE only if --allow-delete is also set).
 */
public class SpannerSchemaSync {

    // ---------- JSON model ----------

    public static class SchemaFile {
        List<TableDef> tables;
    }

    public static class TableDef {
        String table;
        @SerializedName("primaryKey")
        List<String> primaryKey;
        List<ColumnDef> columns;
    }

    public static class ColumnDef {
        String name;
        String type;      // STRING, INT64, FLOAT64, BOOL, BYTES, TIMESTAMP, DATE, NUMERIC, JSON
        Integer size;      // only meaningful for STRING / BYTES; null/absent = MAX
        Boolean nullable;  // defaults to true if absent

        boolean isNullable() {
            return nullable == null || nullable;
        }
    }

    // ---------- live-schema model ----------

    private static class LiveColumn {
        String name;
        String spannerType; // as reported by INFORMATION_SCHEMA, e.g. STRING(255)
        boolean nullable;
    }

    // ---------- change model ----------

    private enum ChangeType { CREATE_TABLE, ADD, MODIFY, DELETE }

    private static class Change {
        ChangeType type;
        String table;
        String column;   // null for CREATE_TABLE
        String detail;   // human-readable description, e.g. "STRING(64) -> STRING(128)"
        String ddl;       // null for DELETE unless --allow-delete is set (filled in later)
    }

    public static void main(String[] args) throws Exception {
        if (args.length < 4) {
            System.err.println("Usage: java -jar spanner-schema-sync.jar <projectId> <instanceId> <databaseId> <schema.json> [--apply] [--allow-delete]");
            System.exit(1);
        }
        String projectId = args[0];
        String instanceId = args[1];
        String databaseId = args[2];
        String schemaPath = args[3];

        Set<String> flags = new LinkedHashSet<>();
        for (int i = 4; i < args.length; i++) flags.add(args[i].toLowerCase(Locale.ROOT));
        boolean apply = flags.contains("--apply");
        boolean allowDelete = flags.contains("--allow-delete");

        SchemaFile desired = loadSchema(schemaPath);

        SpannerOptions options = SpannerOptions.newBuilder().setProjectId(projectId).build();
        try (Spanner spanner = options.getService();
             DatabaseAdminClient adminClient = DatabaseAdminClient.create()) {

            DatabaseId dbId = DatabaseId.of(projectId, instanceId, databaseId);
            DatabaseClient dbClient = spanner.getDatabaseClient(dbId);

            List<Change> allChanges = new ArrayList<>();
            for (TableDef table : desired.tables) {
                allChanges.addAll(diffTable(dbClient, table));
            }

            if (allChanges.isEmpty()) {
                System.out.println("Schema already up to date. Nothing to do.");
                return;
            }

            printReport(allChanges);

            List<String> ddlToRun = new ArrayList<>();
            for (Change c : allChanges) {
                if (c.type == ChangeType.DELETE && !allowDelete) continue; // reported, not executed
                ddlToRun.add(c.ddl);
            }

            if (!apply) {
                System.out.println("Dry run only. Re-run with --apply to execute"
                        + (containsDeletes(allChanges) && !allowDelete ? " (add --allow-delete to also drop the columns listed above)" : "") + ".");
                return;
            }

            if (ddlToRun.isEmpty()) {
                System.out.println("Nothing to apply (deletions require --allow-delete).");
                return;
            }

            System.out.println("Applying " + ddlToRun.size() + " statement(s)...");
            DatabaseName dbName = DatabaseName.of(projectId, instanceId, databaseId);
            adminClient.updateDatabaseDdlAsync(dbName, ddlToRun).get();
            System.out.println("Done.");
        }
    }

    private static boolean containsDeletes(List<Change> changes) {
        for (Change c : changes) if (c.type == ChangeType.DELETE) return true;
        return false;
    }

    private static void printReport(List<Change> changes) {
        List<Change> creates = filter(changes, ChangeType.CREATE_TABLE);
        List<Change> adds = filter(changes, ChangeType.ADD);
        List<Change> modifies = filter(changes, ChangeType.MODIFY);
        List<Change> deletes = filter(changes, ChangeType.DELETE);

        System.out.println("Schema diff: " + creates.size() + " table(s) to create, "
                + adds.size() + " column(s) to add, "
                + modifies.size() + " column(s) to modify, "
                + deletes.size() + " column(s) to delete\n");

        if (!creates.isEmpty()) {
            System.out.println("NEW TABLES:");
            for (Change c : creates) System.out.println("  + " + c.table);
            System.out.println();
        }
        if (!adds.isEmpty()) {
            System.out.println("COLUMNS TO ADD:");
            for (Change c : adds) System.out.println("  + " + c.table + "." + c.column + "  (" + c.detail + ")");
            System.out.println();
        }
        if (!modifies.isEmpty()) {
            System.out.println("COLUMNS TO MODIFY (size change):");
            for (Change c : modifies) System.out.println("  ~ " + c.table + "." + c.column + "  " + c.detail);
            System.out.println();
        }
        if (!deletes.isEmpty()) {
            System.out.println("COLUMNS TO DELETE (present in Spanner, missing from schema.json):");
            for (Change c : deletes) System.out.println("  - " + c.table + "." + c.column + "  (" + c.detail + ")");
            System.out.println("  NOTE: deletions are NOT executed unless --allow-delete is passed.\n");
        }

        System.out.println("Planned DDL:");
        for (Change c : changes) {
            if (c.ddl != null) System.out.println("  " + c.ddl + ";");
        }
        System.out.println();
    }

    private static List<Change> filter(List<Change> changes, ChangeType type) {
        List<Change> out = new ArrayList<>();
        for (Change c : changes) if (c.type == type) out.add(c);
        return out;
    }

    private static SchemaFile loadSchema(String path) throws Exception {
        try (Reader r = new FileReader(path)) {
            return new Gson().fromJson(r, SchemaFile.class);
        }
    }

    /**
     * Returns every change needed to bring `table` in line with its desired
     * definition: CREATE_TABLE if missing, otherwise ADD/MODIFY/DELETE per column.
     */
    private static List<Change> diffTable(DatabaseClient dbClient, TableDef table) {
        List<Change> changes = new ArrayList<>();
        Map<String, LiveColumn> live = fetchLiveColumns(dbClient, table.table);

        if (live.isEmpty()) {
            Change c = new Change();
            c.type = ChangeType.CREATE_TABLE;
            c.table = table.table;
            c.ddl = buildCreateTable(table);
            changes.add(c);
            return changes;
        }

        Set<String> desiredColumnNames = new LinkedHashSet<>();
        for (ColumnDef col : table.columns) desiredColumnNames.add(col.name.toUpperCase(Locale.ROOT));

        for (ColumnDef col : table.columns) {
            LiveColumn existing = live.get(col.name.toUpperCase(Locale.ROOT));
            String desiredType = spannerType(col);

            if (existing == null) {
                Change c = new Change();
                c.type = ChangeType.ADD;
                c.table = table.table;
                c.column = col.name;
                c.detail = desiredType + (col.isNullable() ? "" : " NOT NULL");
                c.ddl = String.format("ALTER TABLE %s ADD COLUMN %s %s%s",
                        table.table, col.name, desiredType, col.isNullable() ? "" : " NOT NULL");
                changes.add(c);
            } else if (isWideningStringOrBytes(existing.spannerType, desiredType)) {
                // Spanner allows widening STRING/BYTES in place; it does not allow
                // narrowing or changing the base type, so those are intentionally skipped.
                Change c = new Change();
                c.type = ChangeType.MODIFY;
                c.table = table.table;
                c.column = col.name;
                c.detail = existing.spannerType + " -> " + desiredType;
                String nullability = existing.nullable ? "" : " NOT NULL";
                c.ddl = String.format("ALTER TABLE %s ALTER COLUMN %s %s%s",
                        table.table, col.name, desiredType, nullability);
                changes.add(c);
            }
            // else: column exists and matches (or is a non-widening type change,
            // which we deliberately do not attempt automatically) -> no-op
        }

        // Columns that exist live but were removed from schema.json.
        for (LiveColumn existing : live.values()) {
            if (!desiredColumnNames.contains(existing.name.toUpperCase(Locale.ROOT))) {
                Change c = new Change();
                c.type = ChangeType.DELETE;
                c.table = table.table;
                c.column = existing.name;
                c.detail = "currently " + existing.spannerType;
                c.ddl = String.format("ALTER TABLE %s DROP COLUMN %s", table.table, existing.name);
                changes.add(c);
            }
        }

        return changes;
    }

    private static Map<String, LiveColumn> fetchLiveColumns(DatabaseClient dbClient, String tableName) {
        Map<String, LiveColumn> result = new LinkedHashMap<>();
        Statement stmt = Statement.newBuilder(
                        "SELECT COLUMN_NAME, SPANNER_TYPE, IS_NULLABLE " +
                        "FROM INFORMATION_SCHEMA.COLUMNS " +
                        "WHERE TABLE_SCHEMA = '' AND TABLE_NAME = @tableName")
                .bind("tableName").to(tableName)
                .build();

        try (ResultSet rs = dbClient.singleUse().executeQuery(stmt)) {
            while (rs.next()) {
                LiveColumn c = new LiveColumn();
                c.name = rs.getString("COLUMN_NAME");
                c.spannerType = rs.getString("SPANNER_TYPE");
                c.nullable = "YES".equalsIgnoreCase(rs.getString("IS_NULLABLE"));
                result.put(c.name.toUpperCase(Locale.ROOT), c);
            }
        }
        return result;
    }

    private static String buildCreateTable(TableDef table) {
        StringBuilder sb = new StringBuilder();
        sb.append("CREATE TABLE ").append(table.table).append(" (\n");
        for (int i = 0; i < table.columns.size(); i++) {
            ColumnDef col = table.columns.get(i);
            sb.append("  ").append(col.name).append(" ").append(spannerType(col));
            if (!col.isNullable()) sb.append(" NOT NULL");
            if (i < table.columns.size() - 1) sb.append(",");
            sb.append("\n");
        }
        sb.append(") PRIMARY KEY (").append(String.join(", ", table.primaryKey)).append(")");
        return sb.toString();
    }

    /** Maps a JSON column definition to a Spanner type literal, e.g. STRING(255), INT64. */
    private static String spannerType(ColumnDef col) {
        String type = col.type.toUpperCase(Locale.ROOT);
        switch (type) {
            case "STRING":
                return "STRING(" + (col.size != null ? col.size : "MAX") + ")";
            case "BYTES":
                return "BYTES(" + (col.size != null ? col.size : "MAX") + ")";
            case "INT64":
            case "FLOAT64":
            case "BOOL":
            case "TIMESTAMP":
            case "DATE":
            case "NUMERIC":
            case "JSON":
                return type;
            default:
                throw new IllegalArgumentException("Unsupported column type in schema.json: " + col.type);
        }
    }

    /** True if `desired` is a STRING/BYTES type with a strictly larger (or MAX) size than `existing`. */
    private static boolean isWideningStringOrBytes(String existingType, String desiredType) {
        Integer existingSize = extractSize(existingType);
        Integer desiredSize = extractSize(desiredType);
        boolean sameBaseType = baseType(existingType).equals(baseType(desiredType));
        if (!sameBaseType) return false;
        if (existingSize == null) return false; // already MAX, nothing to widen
        if (desiredSize == null) return true;    // widening to MAX
        return desiredSize > existingSize;
    }

    private static String baseType(String spannerType) {
        int idx = spannerType.indexOf('(');
        return idx == -1 ? spannerType : spannerType.substring(0, idx);
    }

    private static Integer extractSize(String spannerType) {
        int start = spannerType.indexOf('(');
        int end = spannerType.indexOf(')');
        if (start == -1 || end == -1) return null;
        String inner = spannerType.substring(start + 1, end);
        if ("MAX".equalsIgnoreCase(inner)) return null;
        try {
            return Integer.parseInt(inner);
        } catch (NumberFormatException e) {
            return null;
        }
    }
}
