import com.google.cloud.spanner.DatabaseClient;
import com.google.cloud.spanner.DatabaseId;
import com.google.cloud.spanner.ResultSet;
import com.google.cloud.spanner.Spanner;
import com.google.cloud.spanner.SpannerOptions;
import com.google.cloud.spanner.Statement;

import java.util.ArrayList;
import java.util.Comparator;
import java.util.HashSet;
import java.util.List;
import java.util.Set;

public class SpannerColumnDiff {

    // ============================================================
    // CONFIGURATION
    // ============================================================

    private static final String PROJECT_ID = "your-project-id";

    private static final String INSTANCE_1 = "instance-1";
    private static final String DATABASE_1 = "database-1";

    private static final String INSTANCE_2 = "instance-2";
    private static final String DATABASE_2 = "database-2";

    private static final String TABLE_NAME = "payment_client_info";


    public static void main(String[] args) {

        Set<String> db1Columns =
                getColumns(INSTANCE_1, DATABASE_1);

        Set<String> db2Columns =
                getColumns(INSTANCE_2, DATABASE_2);

        printDifference(db1Columns, db2Columns);
    }


    // ============================================================
    // GET COLUMNS
    // ============================================================

    private static Set<String> getColumns(
            String instance,
            String database) {

        Set<String> columns = new HashSet<>();

        Spanner spanner = SpannerOptions.newBuilder()
                .setProjectId(PROJECT_ID)
                .build()
                .getService();

        try {

            DatabaseClient client =
                    spanner.getDatabaseClient(
                            DatabaseId.of(
                                    PROJECT_ID,
                                    instance,
                                    database
                            )
                    );

            String sql = """
                    SELECT COLUMN_NAME
                    FROM INFORMATION_SCHEMA.COLUMNS
                    WHERE TABLE_SCHEMA = ''
                      AND TABLE_NAME = @tableName
                    """;

            Statement statement = Statement.newBuilder(sql)
                    .bind("tableName")
                    .to(TABLE_NAME)
                    .build();

            ResultSet resultSet =
                    client.singleUse()
                            .executeQuery(statement);

            while (resultSet.next()) {

                columns.add(
                        resultSet.getString("COLUMN_NAME")
                );
            }

        } finally {
            spanner.close();
        }

        return columns;
    }


    // ============================================================
    // SORT COLUMNS
    // ============================================================

    private static List<String> sortColumns(
            Set<String> columns) {

        List<String> sortedColumns =
                new ArrayList<>(columns);

        sortedColumns.sort(
                Comparator
                        .comparing(
                                SpannerColumnDiff::getSortKey,
                                String.CASE_INSENSITIVE_ORDER
                        )
                        .thenComparing(
                                String.CASE_INSENSITIVE_ORDER
                        )
        );

        return sortedColumns;
    }


    // ============================================================
    // GET SORT KEY
    // ============================================================

    private static String getSortKey(
            String columnName) {

        /*
         * Remove E2E prefix ONLY for sorting.
         *
         * PaymentType       -> PaymentType
         * E2EPaymentType    -> PaymentType
         *
         * PaymentStatus     -> PaymentStatus
         * E2EPaymentStatus  -> PaymentStatus
         *
         * Original column name is never modified.
         */

        if (columnName.startsWith("E2E")) {
            return columnName.substring(3);
        }

        return columnName;
    }


    // ============================================================
    // COMPARE
    // ============================================================

    private static void printDifference(
            Set<String> db1Columns,
            Set<String> db2Columns) {

        Set<String> onlyInDb1 =
                new HashSet<>(db1Columns);

        onlyInDb1.removeAll(db2Columns);

        Set<String> onlyInDb2 =
                new HashSet<>(db2Columns);

        onlyInDb2.removeAll(db1Columns);


        // ========================================================
        // HEADER
        // ========================================================

        System.out.println();
        System.out.println(
                "================================================================"
        );
        System.out.println(
                "              SPANNER COLUMN DIFFERENCE REPORT"
        );
        System.out.println(
                "================================================================"
        );

        System.out.println();
        System.out.println("Table      : " + TABLE_NAME);
        System.out.println("Database 1 : " + DATABASE_1);
        System.out.println("Database 2 : " + DATABASE_2);


        // ========================================================
        // DATABASE 1
        // ========================================================

        System.out.println();
        System.out.println(
                "----------------------------------------------------------------"
        );
        System.out.println(
                " DATABASE 1 COLUMNS"
        );
        System.out.println(
                "----------------------------------------------------------------"
        );

        printColumns(db1Columns);


        // ========================================================
        // DATABASE 2
        // ========================================================

        System.out.println();
        System.out.println(
                "----------------------------------------------------------------"
        );
        System.out.println(
                " DATABASE 2 COLUMNS"
        );
        System.out.println(
                "----------------------------------------------------------------"
        );

        printColumns(db2Columns);


        // ========================================================
        // DIFFERENCES
        // ========================================================

        System.out.println();
        System.out.println(
                "================================================================"
        );
        System.out.println(
                "                         DIFFERENCES"
        );
        System.out.println(
                "================================================================"
        );


        System.out.println();
        System.out.println(
                "COLUMNS ONLY IN DATABASE 1"
        );
        System.out.println(
                "----------------------------------------------------------------"
        );

        printColumns(onlyInDb1);


        System.out.println();
        System.out.println(
                "COLUMNS ONLY IN DATABASE 2"
        );
        System.out.println(
                "----------------------------------------------------------------"
        );

        printColumns(onlyInDb2);


        // ========================================================
        // SUMMARY
        // ========================================================

        System.out.println();
        System.out.println(
                "================================================================"
        );
        System.out.println(
                "                           SUMMARY"
        );
        System.out.println(
                "================================================================"
        );

        System.out.printf(
                "Database 1 total columns : %d%n",
                db1Columns.size()
        );

        System.out.printf(
                "Database 2 total columns : %d%n",
                db2Columns.size()
        );

        System.out.printf(
                "Only in Database 1       : %d%n",
                onlyInDb1.size()
        );

        System.out.printf(
                "Only in Database 2       : %d%n",
                onlyInDb2.size()
        );

        System.out.println();

        if (onlyInDb1.isEmpty() && onlyInDb2.isEmpty()) {

            System.out.println(
                    "RESULT                    : NO DIFFERENCES"
            );

        } else {

            System.out.println(
                    "RESULT                    : DIFFERENCES FOUND"
            );
        }

        System.out.println(
                "================================================================"
        );
    }


    // ============================================================
    // PRINT COLUMNS
    // ============================================================

    private static void printColumns(
            Set<String> columns) {

        if (columns.isEmpty()) {
            System.out.println("  None");
            return;
        }

        List<String> sortedColumns =
                sortColumns(columns);

        int count = 1;

        for (String column : sortedColumns) {

            System.out.printf(
                    "  %3d. %s%n",
                    count++,
                    column
            );
        }
    }
}