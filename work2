import com.google.cloud.spanner.DatabaseClient;
import com.google.cloud.spanner.DatabaseId;
import com.google.cloud.spanner.ResultSet;
import com.google.cloud.spanner.Spanner;
import com.google.cloud.spanner.SpannerOptions;
import com.google.cloud.spanner.Statement;

import java.util.Set;
import java.util.TreeSet;

public class SpannerColumnDiff {

    // ============================================================
    // CONFIGURATION
    // ============================================================

    private static final String PROJECT_ID = "your-project-id";

    private static final String INSTANCE_1 = "instance-1";
    private static final String DATABASE_1 = "database-1";

    private static final String INSTANCE_2 = "instance-2";
    private static final String DATABASE_2 = "database-2";

    private static final String TABLE_NAME = "payment_client_info";


    public static void main(String[] args) {

        Set<String> db1Columns =
                getColumns(INSTANCE_1, DATABASE_1);

        Set<String> db2Columns =
                getColumns(INSTANCE_2, DATABASE_2);

        printDifference(db1Columns, db2Columns);
    }


    // ============================================================
    // GET COLUMNS FROM SPANNER
    // ============================================================

    private static Set<String> getColumns(
            String instance,
            String database) {

        /*
         * TreeSet automatically sorts column names alphabetically.
         *
         * Example:
         *
         * E2EPaymentType
         * PaymentType
         * ReferenceNumber
         * Status
         * UETR
         */
        Set<String> columns = new TreeSet<>();

        Spanner spanner = SpannerOptions.newBuilder()
                .setProjectId(PROJECT_ID)
                .build()
                .getService();

        try {

            DatabaseId databaseId = DatabaseId.of(
                    PROJECT_ID,
                    instance,
                    database
            );

            DatabaseClient client =
                    spanner.getDatabaseClient(databaseId);


            String sql = """
                    SELECT COLUMN_NAME
                    FROM INFORMATION_SCHEMA.COLUMNS
                    WHERE TABLE_SCHEMA = ''
                      AND TABLE_NAME = @tableName
                    """;


            Statement statement = Statement.newBuilder(sql)
                    .bind("tableName")
                    .to(TABLE_NAME)
                    .build();


            ResultSet resultSet =
                    client.singleUse()
                            .executeQuery(statement);


            while (resultSet.next()) {

                String columnName =
                        resultSet.getString("COLUMN_NAME");

                columns.add(columnName);
            }

        } finally {

            spanner.close();
        }

        return columns;
    }


    // ============================================================
    // COMPARE DATABASES
    // ============================================================

    private static void printDifference(
            Set<String> db1Columns,
            Set<String> db2Columns) {


        /*
         * Columns which exist in DB1 but NOT in DB2
         */
        Set<String> onlyInDb1 =
                new TreeSet<>(db1Columns);

        onlyInDb1.removeAll(db2Columns);


        /*
         * Columns which exist in DB2 but NOT in DB1
         */
        Set<String> onlyInDb2 =
                new TreeSet<>(db2Columns);

        onlyInDb2.removeAll(db1Columns);


        // ========================================================
        // HEADER
        // ========================================================

        System.out.println();

        System.out.println(
                "================================================================"
        );

        System.out.println(
                "              SPANNER COLUMN DIFFERENCE REPORT"
        );

        System.out.println(
                "================================================================"
        );

        System.out.println();

        System.out.println(
                "Table      : " + TABLE_NAME
        );

        System.out.println(
                "Database 1 : " + DATABASE_1
        );

        System.out.println(
                "Database 2 : " + DATABASE_2
        );


        // ========================================================
        // DATABASE 1 COLUMNS
        // ========================================================

        System.out.println();

        System.out.println(
                "----------------------------------------------------------------"
        );

        System.out.println(
                " DATABASE 1 COLUMNS"
        );

        System.out.println(
                "----------------------------------------------------------------"
        );

        printColumns(db1Columns);


        // ========================================================
        // DATABASE 2 COLUMNS
        // ========================================================

        System.out.println();

        System.out.println(
                "----------------------------------------------------------------"
        );

        System.out.println(
                " DATABASE 2 COLUMNS"
        );

        System.out.println(
                "----------------------------------------------------------------"
        );

        printColumns(db2Columns);


        // ========================================================
        // DIFFERENCES
        // ========================================================

        System.out.println();

        System.out.println(
                "================================================================"
        );

        System.out.println(
                "                         DIFFERENCES"
        );

        System.out.println(
                "================================================================"
        );


        // --------------------------------------------------------
        // ONLY IN DATABASE 1
        // --------------------------------------------------------

        System.out.println();

        System.out.println(
                "COLUMNS ONLY IN DATABASE 1"
        );

        System.out.println(
                "----------------------------------------------------------------"
        );

        if (onlyInDb1.isEmpty()) {

            System.out.println("  None");

        } else {

            printColumns(onlyInDb1);
        }


        // --------------------------------------------------------
        // ONLY IN DATABASE 2
        // --------------------------------------------------------

        System.out.println();

        System.out.println(
                "COLUMNS ONLY IN DATABASE 2"
        );

        System.out.println(
                "----------------------------------------------------------------"
        );

        if (onlyInDb2.isEmpty()) {

            System.out.println("  None");

        } else {

            printColumns(onlyInDb2);
        }


        // ========================================================
        // SUMMARY
        // ========================================================

        System.out.println();

        System.out.println(
                "================================================================"
        );

        System.out.println(
                "                           SUMMARY"
        );

        System.out.println(
                "================================================================"
        );

        System.out.printf(
                "Database 1 total columns : %d%n",
                db1Columns.size()
        );

        System.out.printf(
                "Database 2 total columns : %d%n",
                db2Columns.size()
        );

        System.out.printf(
                "Only in Database 1       : %d%n",
                onlyInDb1.size()
        );

        System.out.printf(
                "Only in Database 2       : %d%n",
                onlyInDb2.size()
        );


        System.out.println();

        if (onlyInDb1.isEmpty() && onlyInDb2.isEmpty()) {

            System.out.println(
                    "RESULT                    : NO DIFFERENCES"
            );

        } else {

            System.out.println(
                    "RESULT                    : DIFFERENCES FOUND"
            );
        }

        System.out.println(
                "================================================================"
        );

        System.out.println();
    }


    // ============================================================
    // PRINT COLUMNS
    // ============================================================

    private static void printColumns(
            Set<String> columns) {

        int count = 1;

        for (String column : columns) {

            System.out.printf(
                    "  %3d. %s%n",
                    count++,
                    column
            );
        }
    }
}