package com.example.spannersync;

import com.google.cloud.spanner.DatabaseClient;
import com.google.cloud.spanner.DatabaseId;
import com.google.cloud.spanner.ResultSet;
import com.google.cloud.spanner.Spanner;
import com.google.cloud.spanner.SpannerOptions;
import com.google.cloud.spanner.Statement;
import com.google.cloud.spanner.admin.database.v1.DatabaseAdminClient;
import com.google.gson.Gson;
import com.google.gson.annotations.SerializedName;
import com.google.spanner.admin.database.v1.DatabaseName;

import java.io.FileReader;
import java.io.Reader;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.LinkedHashSet;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.Scanner;
import java.util.Set;

public class SpannerSchemaSync {

    // ---------- JSON model ----------

    public static class SchemaFile {
        List<TableDef> tables;
    }

    public static class TableDef {
        String table;

        @SerializedName("primaryKey")
        List<String> primaryKey;

        List<ColumnDef> columns;
    }

    public static class ColumnDef {
        String name;
        String type;
        Integer size;
        Boolean nullable;

        boolean isNullable() {
            return nullable == null || nullable;
        }
    }

    // ---------- Live schema model ----------

    private static class LiveColumn {
        String name;
        String spannerType;
        boolean nullable;
    }

    // ---------- Change model ----------

    private enum ChangeType {
        CREATE_TABLE,
        ADD,
        MODIFY,
        DELETE
    }

    private static class Change {
        ChangeType type;
        String table;
        String column;
        String detail;
        String ddl;
    }

    public static void main(String[] args) throws Exception {
        if (args.length < 4) {
            printUsage();
            System.exit(1);
        }

        String projectId = args[0];
        String instanceId = args[1];
        String databaseId = args[2];
        String schemaPath = args[3];

        Set<String> flags = new LinkedHashSet<>();

        for (int i = 4; i < args.length; i++) {
            flags.add(args[i].toLowerCase(Locale.ROOT));
        }

        boolean apply = flags.contains("--apply");
        boolean allowDelete = flags.contains("--allow-delete");
        boolean autoConfirm =
                flags.contains("--yes") || flags.contains("-y");

        SchemaFile desired = loadSchema(schemaPath);

        if (desired == null || desired.tables == null) {
            throw new IllegalArgumentException(
                    "Invalid schema.json: 'tables' is missing."
            );
        }

        SpannerOptions options = SpannerOptions.newBuilder()
                .setProjectId(projectId)
                .build();

        try (Spanner spanner = options.getService();
             DatabaseAdminClient adminClient =
                     DatabaseAdminClient.create()) {

            DatabaseId dbId = DatabaseId.of(
                    projectId,
                    instanceId,
                    databaseId
            );

            DatabaseClient dbClient =
                    spanner.getDatabaseClient(dbId);

            List<Change> allChanges = new ArrayList<>();

            for (TableDef table : desired.tables) {
                allChanges.addAll(
                        diffTable(dbClient, table)
                );
            }

            if (allChanges.isEmpty()) {
                System.out.println(
                        "Schema already up to date. Nothing to do."
                );
                return;
            }

            printReport(allChanges);

            List<String> ddlToRun = new ArrayList<>();

            for (Change change : allChanges) {
                if (change.type == ChangeType.DELETE
                        && !allowDelete) {
                    continue;
                }

                if (change.ddl != null) {
                    ddlToRun.add(change.ddl);
                }
            }

            // Dry run
            if (!apply) {
                System.out.println(
                        "Dry run only. No changes were made."
                );

                if (containsDeletes(allChanges)
                        && !allowDelete) {
                    System.out.println(
                            "To execute deletions, re-run with "
                                    + "--apply --allow-delete."
                    );
                } else {
                    System.out.println(
                            "Re-run with --apply to execute "
                                    + "the planned changes."
                    );
                }

                return;
            }

            if (ddlToRun.isEmpty()) {
                System.out.println("Nothing to apply.");

                if (containsDeletes(allChanges)
                        && !allowDelete) {
                    System.out.println(
                            "Deletions require --allow-delete."
                    );
                }

                return;
            }

            // Ask for confirmation before applying
            if (!autoConfirm) {
                System.out.println();
                System.out.println(
                        "WARNING: The above schema changes "
                                + "will be applied to Spanner."
                );

                System.out.println(
                        "Statements to execute: "
                                + ddlToRun.size()
                );

                System.out.println();

                if (!confirmApply()) {
                    System.out.println(
                            "Schema update cancelled. "
                                    + "No changes were made."
                    );
                    return;
                }
            }

            System.out.println();
            System.out.println(
                    "Applying "
                            + ddlToRun.size()
                            + " statement(s)..."
            );

            DatabaseName dbName = DatabaseName.of(
                    projectId,
                    instanceId,
                    databaseId
            );

            adminClient
                    .updateDatabaseDdlAsync(
                            dbName,
                            ddlToRun
                    )
                    .get();

            System.out.println();
            System.out.println(
                    "Schema update completed successfully."
            );
        }
    }

    private static boolean confirmApply() {
        try (Scanner scanner = new Scanner(System.in)) {
            System.out.print(
                    "Do you want to apply these schema changes? "
                            + "(yes/no): "
            );

            String response = scanner.nextLine()
                    .trim()
                    .toLowerCase(Locale.ROOT);

            return response.equals("yes")
                    || response.equals("y");
        }
    }

    private static void printUsage() {
        System.err.println(
                "Usage: java -jar spanner-schema-sync.jar "
                        + "<projectId> <instanceId> "
                        + "<databaseId> <schema.json> "
                        + "[--apply] [--allow-delete] [--yes]"
        );
    }

    private static boolean containsDeletes(
            List<Change> changes) {

        for (Change change : changes) {
            if (change.type == ChangeType.DELETE) {
                return true;
            }
        }

        return false;
    }

    private static void printReport(
            List<Change> changes) {

        List<Change> creates =
                filter(changes, ChangeType.CREATE_TABLE);

        List<Change> adds =
                filter(changes, ChangeType.ADD);

        List<Change> modifies =
                filter(changes, ChangeType.MODIFY);

        List<Change> deletes =
                filter(changes, ChangeType.DELETE);

        System.out.println();
        System.out.println("======================================");
        System.out.println("           SPANNER SCHEMA DIFF");
        System.out.println("======================================");
        System.out.println();

        System.out.println(
                "Tables to create : " + creates.size()
        );

        System.out.println(
                "Columns to add   : " + adds.size()
        );

        System.out.println(
                "Columns to modify: " + modifies.size()
        );

        System.out.println(
                "Columns to delete: " + deletes.size()
        );

        System.out.println();

        if (!creates.isEmpty()) {
            System.out.println("NEW TABLES:");

            for (Change change : creates) {
                System.out.println(
                        "  + " + change.table
                );
            }

            System.out.println();
        }

        if (!adds.isEmpty()) {
            System.out.println("COLUMNS TO ADD:");

            for (Change change : adds) {
                System.out.println(
                        "  + "
                                + change.table
                                + "."
                                + change.column
                                + " ("
                                + change.detail
                                + ")"
                );
            }

            System.out.println();
        }

        if (!modifies.isEmpty()) {
            System.out.println(
                    "COLUMNS TO MODIFY (size change):"
            );

            for (Change change : modifies) {
                System.out.println(
                        "  ~ "
                                + change.table
                                + "."
                                + change.column
                                + " "
                                + change.detail
                );
            }

            System.out.println();
        }

        if (!deletes.isEmpty()) {
            System.out.println(
                    "COLUMNS TO DELETE "
                            + "(present in Spanner, "
                            + "missing from schema.json):"
            );

            for (Change change : deletes) {
                System.out.println(
                        "  - "
                                + change.table
                                + "."
                                + change.column
                                + " ("
                                + change.detail
                                + ")"
                );
            }

            System.out.println();
            System.out.println(
                    "NOTE: deletions are NOT executed "
                            + "unless --allow-delete is passed."
            );
            System.out.println();
        }

        System.out.println("PLANNED DDL:");

        for (Change change : changes) {
            if (change.ddl != null) {
                System.out.println(
                        "  " + change.ddl + ";"
                );
            }
        }

        System.out.println();
    }

    private static List<Change> filter(
            List<Change> changes,
            ChangeType type) {

        List<Change> result = new ArrayList<>();

        for (Change change : changes) {
            if (change.type == type) {
                result.add(change);
            }
        }

        return result;
    }

    private static SchemaFile loadSchema(
            String path) throws Exception {

        try (Reader reader = new FileReader(path)) {
            return new Gson().fromJson(
                    reader,
                    SchemaFile.class
            );
        }
    }

    private static List<Change> diffTable(
            DatabaseClient dbClient,
            TableDef table) {

        List<Change> changes = new ArrayList<>();

        Map<String, LiveColumn> live =
                fetchLiveColumns(
                        dbClient,
                        table.table
                );

        if (live.isEmpty()) {
            Change change = new Change();

            change.type = ChangeType.CREATE_TABLE;
            change.table = table.table;
            change.ddl = buildCreateTable(table);

            changes.add(change);

            return changes;
        }

        Set<String> desiredColumnNames =
                new LinkedHashSet<>();

        for (ColumnDef column : table.columns) {
            desiredColumnNames.add(
                    column.name.toUpperCase(Locale.ROOT)
            );
        }

        for (ColumnDef column : table.columns) {
            LiveColumn existing = live.get(
                    column.name.toUpperCase(Locale.ROOT)
            );

            String desiredType = spannerType(column);

            if (existing == null) {
                Change change = new Change();

                change.type = ChangeType.ADD;
                change.table = table.table;
                change.column = column.name;
                change.detail = desiredType
                        + (column.isNullable()
                        ? ""
                        : " NOT NULL");

                change.ddl = String.format(
                        "ALTER TABLE %s ADD COLUMN %s %s%s",
                        table.table,
                        column.name,
                        desiredType,
                        column.isNullable()
                                ? ""
                                : " NOT NULL"
                );

                changes.add(change);

            } else if (isWideningStringOrBytes(
                    existing.spannerType,
                    desiredType
            )) {

                Change change = new Change();

                change.type = ChangeType.MODIFY;
                change.table = table.table;
                change.column = column.name;
                change.detail =
                        existing.spannerType
                                + " -> "
                                + desiredType;

                String nullability =
                        existing.nullable
                                ? ""
                                : " NOT NULL";

                change.ddl = String.format(
                        "ALTER TABLE %s ALTER COLUMN %s %s%s",
                        table.table,
                        column.name,
                        desiredType,
                        nullability
                );

                changes.add(change);
            }
        }

        for (LiveColumn existing : live.values()) {
            if (!desiredColumnNames.contains(
                    existing.name.toUpperCase(Locale.ROOT)
            )) {

                Change change = new Change();

                change.type = ChangeType.DELETE;
                change.table = table.table;
                change.column = existing.name;
                change.detail =
                        "currently " + existing.spannerType;

                change.ddl = String.format(
                        "ALTER TABLE %s DROP COLUMN %s",
                        table.table,
                        existing.name
                );

                changes.add(change);
            }
        }

        return changes;
    }

    private static Map<String, LiveColumn> fetchLiveColumns(
            DatabaseClient dbClient,
            String tableName) {

        Map<String, LiveColumn> result =
                new LinkedHashMap<>();

        Statement statement = Statement.newBuilder(
                        "SELECT COLUMN_NAME, SPANNER_TYPE, IS_NULLABLE "
                                + "FROM INFORMATION_SCHEMA.COLUMNS "
                                + "WHERE TABLE_SCHEMA = '' "
                                + "AND TABLE_NAME = @tableName"
                )
                .bind("tableName")
                .to(tableName)
                .build();

        try (ResultSet resultSet =
                     dbClient
                             .singleUse()
                             .executeQuery(statement)) {

            while (resultSet.next()) {
                LiveColumn column = new LiveColumn();

                column.name =
                        resultSet.getString("COLUMN_NAME");

                column.spannerType =
                        resultSet.getString("SPANNER_TYPE");

                column.nullable =
                        "YES".equalsIgnoreCase(
                                resultSet.getString("IS_NULLABLE")
                        );

                result.put(
                        column.name.toUpperCase(Locale.ROOT),
                        column
                );
            }
        }

        return result;
    }

    private static String buildCreateTable(
            TableDef table) {

        StringBuilder sb = new StringBuilder();

        sb.append("CREATE TABLE ")
                .append(table.table)
                .append(" (\n");

        for (int i = 0;
             i < table.columns.size();
             i++) {

            ColumnDef column = table.columns.get(i);

            sb.append("  ")
                    .append(column.name)
                    .append(" ")
                    .append(spannerType(column));

            if (!column.isNullable()) {
                sb.append(" NOT NULL");
            }

            if (i < table.columns.size() - 1) {
                sb.append(",");
            }

            sb.append("\n");
        }

        sb.append(") PRIMARY KEY (")
                .append(
                        String.join(
                                ", ",
                                table.primaryKey
                        )
                )
                .append(")");

        return sb.toString();
    }

    private static String spannerType(
            ColumnDef column) {

        String type =
                column.type.toUpperCase(Locale.ROOT);

        switch (type) {
            case "STRING":
                return "STRING("
                        + (column.size != null
                        ? column.size
                        : "MAX")
                        + ")";

            case "BYTES":
                return "BYTES("
                        + (column.size != null
                        ? column.size
                        : "MAX")
                        + ")";

            case "INT64":
            case "FLOAT64":
            case "BOOL":
            case "TIMESTAMP":
            case "DATE":
            case "NUMERIC":
            case "JSON":
                return type;

            default:
                throw new IllegalArgumentException(
                        "Unsupported column type in schema.json: "
                                + column.type
                );
        }
    }

    private static boolean isWideningStringOrBytes(
            String existingType,
            String desiredType) {

        Integer existingSize =
                extractSize(existingType);

        Integer desiredSize =
                extractSize(desiredType);

        boolean sameBaseType =
                baseType(existingType)
                        .equalsIgnoreCase(
                                baseType(desiredType)
                        );

        if (!sameBaseType) {
            return false;
        }

        if (existingSize == null) {
            return false;
        }

        if (desiredSize == null) {
            return true;
        }

        return desiredSize > existingSize;
    }

    private static String baseType(
            String spannerType) {

        int index =
                spannerType.indexOf('(');

        if (index == -1) {
            return spannerType;
        }

        return spannerType.substring(0, index);
    }

    private static Integer extractSize(
            String spannerType) {

        int start =
                spannerType.indexOf('(');

        int end =
                spannerType.indexOf(')');

        if (start == -1 || end == -1) {
            return null;
        }

        String inner =
                spannerType.substring(
                        start + 1,
                        end
                );

        if ("MAX".equalsIgnoreCase(inner)) {
            return null;
        }

        try {
            return Integer.parseInt(inner);
        } catch (NumberFormatException e) {
            return null;
        }
    }
}