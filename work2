import com.google.cloud.spanner.DatabaseClient;
import com.google.cloud.spanner.DatabaseId;
import com.google.cloud.spanner.ResultSet;
import com.google.cloud.spanner.Spanner;
import com.google.cloud.spanner.SpannerOptions;
import com.google.cloud.spanner.Statement;

import java.util.LinkedHashSet;
import java.util.Set;

public class SpannerColumnDiff {

    private static final String PROJECT_ID = "your-project-id";

    private static final String INSTANCE_1 = "instance-1";
    private static final String DATABASE_1 = "database-1";

    private static final String INSTANCE_2 = "instance-2";
    private static final String DATABASE_2 = "database-2";

    private static final String TABLE_NAME = "payment_client_info";

    public static void main(String[] args) {

        Set<String> db1Columns =
                getColumns(INSTANCE_1, DATABASE_1);

        Set<String> db2Columns =
                getColumns(INSTANCE_2, DATABASE_2);

        printDifference(db1Columns, db2Columns);
    }

    private static Set<String> getColumns(
            String instance,
            String database) {

        Set<String> columns = new LinkedHashSet<>();

        Spanner spanner = SpannerOptions.newBuilder()
                .setProjectId(PROJECT_ID)
                .build()
                .getService();

        try {

            DatabaseClient client =
                    spanner.getDatabaseClient(
                            DatabaseId.of(
                                    PROJECT_ID,
                                    instance,
                                    database
                            )
                    );

            String sql = """
                    SELECT COLUMN_NAME
                    FROM INFORMATION_SCHEMA.COLUMNS
                    WHERE TABLE_SCHEMA = ''
                      AND TABLE_NAME = @tableName
                    ORDER BY ORDINAL_POSITION
                    """;

            Statement statement = Statement.newBuilder(sql)
                    .bind("tableName")
                    .to(TABLE_NAME)
                    .build();

            ResultSet resultSet =
                    client.singleUse()
                            .executeQuery(statement);

            while (resultSet.next()) {

                columns.add(
                        resultSet.getString("COLUMN_NAME")
                );
            }

        } finally {
            spanner.close();
        }

        return columns;
    }

    private static void printDifference(
            Set<String> db1Columns,
            Set<String> db2Columns) {

        // Columns present in DB1 but missing from DB2
        Set<String> onlyInDb1 =
                new LinkedHashSet<>(db1Columns);

        onlyInDb1.removeAll(db2Columns);

        // Columns present in DB2 but missing from DB1
        Set<String> onlyInDb2 =
                new LinkedHashSet<>(db2Columns);

        onlyInDb2.removeAll(db1Columns);

        System.out.println();
        System.out.println(
                "============================================================"
        );
        System.out.println(
                "             SPANNER COLUMN DIFFERENCE REPORT"
        );
        System.out.println(
                "============================================================"
        );

        System.out.println();
        System.out.println("Table      : " + TABLE_NAME);
        System.out.println("Database 1 : " + DATABASE_1);
        System.out.println("Database 2 : " + DATABASE_2);

        // ----------------------------------------------------
        // DB1 ONLY
        // ----------------------------------------------------

        System.out.println();
        System.out.println(
                "------------------------------------------------------------"
        );
        System.out.println(
                " COLUMNS ONLY IN DATABASE 1"
        );
        System.out.println(
                "------------------------------------------------------------"
        );

        if (onlyInDb1.isEmpty()) {

            System.out.println("  None");

        } else {

            int count = 1;

            for (String column : onlyInDb1) {

                System.out.printf(
                        "  %2d. %s%n",
                        count++,
                        column
                );
            }
        }

        // ----------------------------------------------------
        // DB2 ONLY
        // ----------------------------------------------------

        System.out.println();
        System.out.println(
                "------------------------------------------------------------"
        );
        System.out.println(
                " COLUMNS ONLY IN DATABASE 2"
        );
        System.out.println(
                "------------------------------------------------------------"
        );

        if (onlyInDb2.isEmpty()) {

            System.out.println("  None");

        } else {

            int count = 1;

            for (String column : onlyInDb2) {

                System.out.printf(
                        "  %2d. %s%n",
                        count++,
                        column
                );
            }
        }

        // ----------------------------------------------------
        // SUMMARY
        // ----------------------------------------------------

        System.out.println();
        System.out.println(
                "------------------------------------------------------------"
        );
        System.out.println(" SUMMARY");
        System.out.println(
                "------------------------------------------------------------"
        );

        System.out.printf(
                "  Database 1 columns : %d%n",
                db1Columns.size()
        );

        System.out.printf(
                "  Database 2 columns : %d%n",
                db2Columns.size()
        );

        System.out.printf(
                "  Only in Database 1 : %d%n",
                onlyInDb1.size()
        );

        System.out.printf(
                "  Only in Database 2 : %d%n",
                onlyInDb2.size()
        );

        System.out.println();

        if (onlyInDb1.isEmpty() && onlyInDb2.isEmpty()) {

            System.out.println(
                    "  Result              : ✓ TABLES HAVE IDENTICAL COLUMNS"
            );

        } else {

            System.out.println(
                    "  Result              : ✗ COLUMN DIFFERENCES FOUND"
            );
        }

        System.out.println(
                "============================================================"
        );
        System.out.println();
    }
}