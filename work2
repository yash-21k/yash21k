package com.example.spannersync;

import com.google.cloud.spanner.DatabaseClient;
import com.google.cloud.spanner.DatabaseId;
import com.google.cloud.spanner.ResultSet;
import com.google.cloud.spanner.Spanner;
import com.google.cloud.spanner.SpannerOptions;
import com.google.cloud.spanner.Statement;
import com.google.cloud.spanner.admin.database.v1.DatabaseAdminClient;
import com.google.spanner.admin.database.v1.DatabaseName;
import com.google.gson.Gson;
import com.google.gson.annotations.SerializedName;

import java.io.FileReader;
import java.io.Reader;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;

/**
 * A tiny "terraform for Spanner schema" tool.
 *
 * You describe your desired tables/columns in a JSON file. This tool:
 *   1. Reads the live schema from INFORMATION_SCHEMA.COLUMNS
 *   2. Diffs it against the JSON
 *   3. Emits/applies only the DDL needed to reconcile (CREATE TABLE for new
 *      tables, ADD COLUMN for new columns, ALTER COLUMN for widened
 *      STRING/BYTES sizes)
 *
 * It never drops or renames anything — this is additive-only by design,
 * which mirrors safe "expand" migrations. Removing/renaming a column is
 * destructive and intentionally NOT automated here.
 *
 * Usage:
 *   java -jar spanner-schema-sync.jar <projectId> <instanceId> <databaseId> <schema.json> [--apply]
 *
 * Without --apply it just prints the DDL it *would* run (dry run).
 * With --apply it actually executes it against Spanner.
 */
public class SpannerSchemaSync {

    // ---------- JSON model ----------

    public static class SchemaFile {
        List<TableDef> tables;
    }

    public static class TableDef {
        String table;
        @SerializedName("primaryKey")
        List<String> primaryKey;
        List<ColumnDef> columns;
    }

    public static class ColumnDef {
        String name;
        String type;      // STRING, INT64, FLOAT64, BOOL, BYTES, TIMESTAMP, DATE, NUMERIC, JSON
        Integer size;      // only meaningful for STRING / BYTES; null/absent = MAX
        Boolean nullable;  // defaults to true if absent

        boolean isNullable() {
            return nullable == null || nullable;
        }
    }

    // ---------- live-schema model ----------

    private static class LiveColumn {
        String name;
        String spannerType; // as reported by INFORMATION_SCHEMA, e.g. STRING(255)
        boolean nullable;
    }

    public static void main(String[] args) throws Exception {
        if (args.length < 4) {
            System.err.println("Usage: java -jar spanner-schema-sync.jar <projectId> <instanceId> <databaseId> <schema.json> [--apply]");
            System.exit(1);
        }
        String projectId = args[0];
        String instanceId = args[1];
        String databaseId = args[2];
        String schemaPath = args[3];
        boolean apply = args.length > 4 && "--apply".equalsIgnoreCase(args[4]);

        SchemaFile desired = loadSchema(schemaPath);

        SpannerOptions options = SpannerOptions.newBuilder().setProjectId(projectId).build();
        try (Spanner spanner = options.getService();
             DatabaseAdminClient adminClient = DatabaseAdminClient.create()) {

            DatabaseId dbId = DatabaseId.of(projectId, instanceId, databaseId);
            DatabaseClient dbClient = spanner.getDatabaseClient(dbId);

            List<String> allDdl = new ArrayList<>();

            for (TableDef table : desired.tables) {
                List<String> ddl = diffTable(dbClient, table);
                allDdl.addAll(ddl);
            }

            if (allDdl.isEmpty()) {
                System.out.println("Schema already up to date. Nothing to do.");
                return;
            }

            System.out.println("Planned DDL (" + allDdl.size() + " statement(s)):");
            for (String s : allDdl) {
                System.out.println("  " + s + ";");
            }

            if (!apply) {
                System.out.println("\nDry run only. Re-run with --apply to execute.");
                return;
            }

            System.out.println("\nApplying...");
            DatabaseName dbName = DatabaseName.of(projectId, instanceId, databaseId);
            adminClient.updateDatabaseDdlAsync(dbName, allDdl).get();
            System.out.println("Done.");
        }
    }

    private static SchemaFile loadSchema(String path) throws Exception {
        try (Reader r = new FileReader(path)) {
            return new Gson().fromJson(r, SchemaFile.class);
        }
    }

    /**
     * Returns the DDL statements needed to bring `table` in line with its
     * desired definition. Empty list if nothing needs to change.
     */
    private static List<String> diffTable(DatabaseClient dbClient, TableDef table) {
        List<String> ddl = new ArrayList<>();
        Map<String, LiveColumn> live = fetchLiveColumns(dbClient, table.table);

        if (live.isEmpty()) {
            // Table doesn't exist yet -> full CREATE TABLE
            ddl.add(buildCreateTable(table));
            return ddl;
        }

        for (ColumnDef col : table.columns) {
            LiveColumn existing = live.get(col.name.toUpperCase(Locale.ROOT));
            String desiredType = spannerType(col);

            if (existing == null) {
                // New column -> ADD COLUMN
                String nullability = col.isNullable() ? "" : " NOT NULL";
                ddl.add(String.format(
                        "ALTER TABLE %s ADD COLUMN %s %s%s",
                        table.table, col.name, desiredType, nullability));
            } else if (isWideningStringOrBytes(existing.spannerType, desiredType)) {
                // Column exists but the declared size grew (e.g. STRING(64) -> STRING(128))
                // Spanner allows widening STRING/BYTES in place; it does not allow
                // narrowing or changing the base type, so those are intentionally skipped.
                String nullability = existing.nullable ? "" : " NOT NULL";
                ddl.add(String.format(
                        "ALTER TABLE %s ALTER COLUMN %s %s%s",
                        table.table, col.name, desiredType, nullability));
            }
            // else: column exists and matches (or is a non-widening type change,
            // which we deliberately do not attempt automatically) -> no-op
        }

        return ddl;
    }

    private static Map<String, LiveColumn> fetchLiveColumns(DatabaseClient dbClient, String tableName) {
        Map<String, LiveColumn> result = new LinkedHashMap<>();
        Statement stmt = Statement.newBuilder(
                        "SELECT COLUMN_NAME, SPANNER_TYPE, IS_NULLABLE " +
                        "FROM INFORMATION_SCHEMA.COLUMNS " +
                        "WHERE TABLE_SCHEMA = '' AND TABLE_NAME = @tableName")
                .bind("tableName").to(tableName)
                .build();

        try (ResultSet rs = dbClient.singleUse().executeQuery(stmt)) {
            while (rs.next()) {
                LiveColumn c = new LiveColumn();
                c.name = rs.getString("COLUMN_NAME");
                c.spannerType = rs.getString("SPANNER_TYPE");
                c.nullable = "YES".equalsIgnoreCase(rs.getString("IS_NULLABLE"));
                result.put(c.name.toUpperCase(Locale.ROOT), c);
            }
        }
        return result;
    }

    private static String buildCreateTable(TableDef table) {
        StringBuilder sb = new StringBuilder();
        sb.append("CREATE TABLE ").append(table.table).append(" (\n");
        for (int i = 0; i < table.columns.size(); i++) {
            ColumnDef col = table.columns.get(i);
            sb.append("  ").append(col.name).append(" ").append(spannerType(col));
            if (!col.isNullable()) sb.append(" NOT NULL");
            if (i < table.columns.size() - 1) sb.append(",");
            sb.append("\n");
        }
        sb.append(") PRIMARY KEY (").append(String.join(", ", table.primaryKey)).append(")");
        return sb.toString();
    }

    /** Maps a JSON column definition to a Spanner type literal, e.g. STRING(255), INT64. */
    private static String spannerType(ColumnDef col) {
        String type = col.type.toUpperCase(Locale.ROOT);
        switch (type) {
            case "STRING":
                return "STRING(" + (col.size != null ? col.size : "MAX") + ")";
            case "BYTES":
                return "BYTES(" + (col.size != null ? col.size : "MAX") + ")";
            case "INT64":
            case "FLOAT64":
            case "BOOL":
            case "TIMESTAMP":
            case "DATE":
            case "NUMERIC":
            case "JSON":
                return type;
            default:
                throw new IllegalArgumentException("Unsupported column type in schema.json: " + col.type);
        }
    }

    /** True if `desired` is a STRING/BYTES type with a strictly larger (or MAX) size than `existing`. */
    private static boolean isWideningStringOrBytes(String existingType, String desiredType) {
        Integer existingSize = extractSize(existingType);
        Integer desiredSize = extractSize(desiredType);
        boolean sameBaseType = baseType(existingType).equals(baseType(desiredType));
        if (!sameBaseType) return false;
        if (existingSize == null) return false; // already MAX, nothing to widen
        if (desiredSize == null) return true;    // widening to MAX
        return desiredSize > existingSize;
    }

    private static String baseType(String spannerType) {
        int idx = spannerType.indexOf('(');
        return idx == -1 ? spannerType : spannerType.substring(0, idx);
    }

    private static Integer extractSize(String spannerType) {
        int start = spannerType.indexOf('(');
        int end = spannerType.indexOf(')');
        if (start == -1 || end == -1) return null;
        String inner = spannerType.substring(start + 1, end);
        if ("MAX".equalsIgnoreCase(inner)) return null;
        try {
            return Integer.parseInt(inner);
        } catch (NumberFormatException e) {
            return null;
        }
    }
}
